# Disaster Missing Persons - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application Settings
# ============================================
APP_NAME="Disaster Missing Persons"
DEBUG=false

# ============================================
# MongoDB Configuration
# ============================================
# Local MongoDB (default)
MONGODB_URL=mongodb://localhost:27017

# MongoDB Atlas (production)
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/disaster_missing_persons?retryWrites=true&w=majority

DATABASE_NAME=disaster_missing_persons

# ============================================
# Security Settings
# ============================================
# IMPORTANT: Change this in production!
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
ALGORITHM=HS256

# Token expiry in minutes (24 hours for disaster scenarios)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# Image Processing
# ============================================
MAX_IMAGE_SIZE_MB=5
IMAGE_QUALITY=60
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300

# ============================================
# Report Settings
# ============================================
# Auto-expire reports after N days
REPORT_AUTO_EXPIRE_DAYS=30

# ============================================
# Server Settings
# ============================================
HOST=0.0.0.0
PORT=8000

# ============================================
# Default Admin Account (created on first run)
# ============================================
DEFAULT_ADMIN_EMAIL=admin@disaster-response.org
DEFAULT_ADMIN_PASSWORD=admin123
